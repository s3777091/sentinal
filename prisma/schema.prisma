generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DIRECT_DATABASE_URL")
}

model User {
  id            Int            @id @default(autoincrement())
  user_Id       String         @unique
  email         String         @unique
  username      String         @unique
  name          String?
  image         String?
  posts         Post[]
  scanData      ScanData[]
  apiServerId   Int?
  apiServer     ApiServer?     @relation(fields: [apiServerId], references: [id])
  conversations Conversation[]
  fileLinks     UserFileLink[] // Add this line to link User with UserFileLink

  @@unique([email, username])
  @@index([apiServerId])
}

model ApiServer {
  id     Int    @id @default(autoincrement())
  apiUrl String @db.VarChar(255)
  users  User[]
  status String @db.VarChar(10)

  @@index([apiUrl])
}

model ScanData {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  title       String?
  level       String?
  more_detail String?
  userId      String
  scanUser    User     @relation(fields: [userId], references: [user_Id])

  @@index([userId])
  @@index([title])
}

model Post {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  room      String   @unique
  updatedAt DateTime @updatedAt
  title     String   @db.VarChar(255)
  content   String?
  imageUrl  String? // Added imageUrl field to store the uploaded image URL
  author    User     @relation(fields: [authorId], references: [user_Id])
  authorId  String

  @@index([authorId]) // Index to optimize querying by authorId
  @@index([createdAt]) // Index to optimize querying posts by creation date
}

model Conversation {
  id        Int      @id @default(autoincrement())
  userId    String
  messages  Json // Store messages as JSON
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [user_Id])

  @@index([userId]) // Index to optimize querying conversations by userId
  @@index([createdAt]) // Index to optimize querying conversations by creation date
}

model UserFileLink {
  id        Int      @id @default(autoincrement())
  url       String
  userId    String
  user      User     @relation(fields: [userId], references: [user_Id])
  createdAt DateTime @default(now())

  @@index([userId]) // Index to optimize querying by userId
  @@index([createdAt]) // Index to optimize querying by creation date
}
