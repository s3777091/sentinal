generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DIRECT_DATABASE_URL")
  // directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  username     String        @unique
  name         String?
  apiServer    String?
  posts        Post[]
  profile      Profile?
  historyChats HistoryChat[] // One User has many HistoryChats
  scanData     ScanData[] // One User has many ScanData

  @@unique([email, username]) // Ensure both email and username are unique
}

model ScanData {
  id             Int      @id @default(autoincrement())
  createdAt      DateTime @default(now())
  title          String   @db.VarChar(255)
  detail         String?
  more_detail    String?
  senderSocketId String?
  userId         Int // Foreign key to relate ScanData to a User
  scanUser       User     @relation(fields: [userId], references: [id]) // Establish relation with User
}

model Post {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  title     String    @db.VarChar(255)
  content   String?
  author    User      @relation(fields: [authorId], references: [id])
  authorId  Int
  comments  Comment[] // One Post has many Comments

  @@index([authorId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  content   String
  post      Post     @relation(fields: [postId], references: [id])
  postId    Int

  @@index([postId])
}

model Chat {
  id            Int         @id @default(autoincrement())
  produce       String      @db.VarChar(255)
  message       String?
  historyChat   HistoryChat @relation(fields: [historyChatId], references: [id])
  historyChatId Int

  @@index([historyChatId])
}

model HistoryChat {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  title     String   @db.VarChar(255)
  chats     Chat[] // One HistoryChat has many Chats
  User      User?    @relation(fields: [userId], references: [id])
  userId    Int?
}

model Profile {
  id     Int     @id @default(autoincrement())
  bio    String?
  user   User    @relation(fields: [userId], references: [id])
  userId Int     @unique
  image  String?

  @@index([userId])
}
