generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DIRECT_DATABASE_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  username     String        @unique
  name         String?
  apiServerId  Int?
  posts        Post[]
  profile      Profile?
  scanData     ScanData[] // One User has many ScanData
  apiServer    ApiServer?    @relation(fields: [apiServerId], references: [id])

  @@unique([email, username]) // Ensure both email and username are unique
  @@index([apiServerId]) // Index to optimize querying users by apiServerId
}

model ApiServer {
  id       Int     @id @default(autoincrement())
  apiUrl   String  @db.VarChar(255)
  users    User[]
  status   String  @db.VarChar(10)
  @@index([apiUrl])
}
model ScanData {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  title       String?
  detail      String?
  more_detail String?
  userId      Int
  scanUser    User     @relation(fields: [userId], references: [id])

  @@index([userId]) // Index to optimize querying scan data by userId
  @@index([title]) // Index to optimize querying by title
}

model Post {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  title     String    @db.VarChar(255)
  content   String?
  author    User      @relation(fields: [authorId], references: [id])
  authorId  Int
  comments  Comment[] // One Post has many Comments

  @@index([authorId]) // Index to optimize querying by authorId
  @@index([createdAt]) // Index to optimize querying posts by creation date
}

model Comment {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  content   String
  post      Post     @relation(fields: [postId], references: [id])
  postId    Int

  @@index([postId]) // Index to optimize querying comments by postId
}

model Profile {
  id     Int     @id @default(autoincrement())
  bio    String?
  user   User    @relation(fields: [userId], references: [id])
  image  String?
  userId Int     @unique

  @@index([userId]) // Index to optimize querying profiles by userId
}
